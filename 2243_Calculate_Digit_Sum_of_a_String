class Solution {
public:
    string digitSum(string s, int k) {
        string thisreround_s = s;
        string nextround_s = "";

        while (thisreround_s.size() > k) {
            nextround_s = "";

            for (int a = 0; a * k < thisreround_s.size(); a++) {
                int sum = 0;

                for (int j = 0; j < k; j++) {
                    if (a * k + j < thisreround_s.size()) {
                        sum += thisreround_s[a * k + j] - '0'; //string[index] is a char
                    }
                }

                nextround_s += to_string(sum);
            }

            thisreround_s = nextround_s;
        }

        return thisreround_s;
    }
};